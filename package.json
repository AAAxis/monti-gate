{
  "name": "monti-anty",
  "version": "1.0.71",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && env -u ELECTRON_RUN_AS_NODE MONTI_LAUNCHER_DEV=1 node scripts/start-macos-app.cjs\"",
    "icons": "env -u ELECTRON_RUN_AS_NODE electron scripts/build-icons.cjs",
    "panel-icon": "env -u ELECTRON_RUN_AS_NODE electron scripts/build-panel-icon.cjs",
    "build": "vite build",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "release": "npm run build && electron-builder --publish always",
    "start": "env -u ELECTRON_RUN_AS_NODE node scripts/start-macos-app.cjs",
    "start:electron": "env -u ELECTRON_RUN_AS_NODE electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "country-flag-icons": "^1.6.20",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "nodemailer": "^9.0.4",
    "rcedit": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.monti.anty",
    "productName": "EasyDeck",
    "icon": "assets/icons/launcher-light.icns",
    "artifactName": "EasyDeck-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "EasyDeck",
        "schemes": [
          "monti"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "extensions/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bundled-browser",
        "to": "browser",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "assets/icons/launcher-light.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "assets/app.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://pub-ab898453f3794cc8b9d0117b4111a778.r2.dev"
      }
    ],
    "asarUnpack": [
      "node_modules/rcedit/**"
    ]
  }
}
