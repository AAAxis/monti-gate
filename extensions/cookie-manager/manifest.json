{
  "manifest_version": 3,
  "name": "Scout Helper",
  "version": "3.1.0",
  "description": "Session dashboard for Scout Web profiles: proxy status, cookies and automations.",
  "permissions": ["cookies", "downloads", "sidePanel", "storage", "tabs", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/on-light/icon-16.png",
    "32": "icons/on-light/icon-32.png",
    "48": "icons/on-light/icon-48.png",
    "128": "icons/on-light/icon-128.png"
  },
  "action": {
    "default_title": "Scout Helper",
    "default_icon": {
      "16": "icons/on-light/icon-16.png",
      "32": "icons/on-light/icon-32.png",
      "48": "icons/on-light/icon-48.png",
      "128": "icons/on-light/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
